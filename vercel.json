{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/painel.html"
    },
    {
      "source": "/oferta/:id",
      "destination": "/api/oferta?id=:id"
    }
  ],
  "functions": {
    "api/telegram.js": {
      "maxDuration": 30
    },
    "api/stores.js": {
      "maxDuration": 30
    }
  }
}
