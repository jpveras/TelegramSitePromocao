{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/painel.html"
    },
    {
      "source": "/oferta/:id",
      "destination": "/api/oferta?id=:id"
    },
    {
      "source": "/loja/:key",
      "destination": "/api/oferta?loja=:key"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/oferta?sitemap=1"
    },
    {
      "source": "/black-friday",
      "destination": "/api/oferta?campanha=1"
    },
    {
      "source": "/11-11",
      "destination": "/api/oferta?campanha=1"
    }
  ],
  "functions": {
    "api/telegram.js": {
      "maxDuration": 30
    },
    "api/stores.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/app",
      "destination": "https://github.com/jpveras/TelegramSitePromocao/releases/latest/download/promocoes-do-veras.apk",
      "permanent": false
    },
    {
      "source": "/canais",
      "destination": "https://linktr.ee/jpverastech",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/report",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/report?weekly=1",
      "schedule": "0 11 * * 0"
    }
  ]
}
