{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/painel.html"
    },
    {
      "source": "/oferta/:id",
      "destination": "/api/oferta?id=:id"
    }
  ],
  "functions": {
    "api/telegram.js": {
      "maxDuration": 30
    },
    "api/stores.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/app",
      "destination": "https://github.com/jpveras/TelegramSitePromocao/releases/latest/download/promocoes-do-veras.apk",
      "permanent": false
    },
    {
      "source": "/canais",
      "destination": "https://linktr.ee/jpverastech",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/report",
      "schedule": "0 2 * * *"
    }
  ]
}
