# Token do seu bot, gerado pelo @BotFather no Telegram
TELEGRAM_BOT_TOKEN=coloque_o_token_aqui

# ID do grupo/canal onde o DisparaPromo posta os anuncios.
# Deixe em branco no inicio: rode o bot, poste algo de teste no grupo,
# e o console vai imprimir o chat_id certo pra voce colar aqui.
TELEGRAM_CHAT_ID=

# Porta do servidor web (site + feed ao vivo)
PORT=3000
