# Variaveis de ambiente do projeto. Na Vercel, cadastre em:
# Project Settings -> Environment Variables. Nunca coloque valores reais no Git.

# Token do bot, gerado pelo @BotFather no Telegram
TELEGRAM_BOT_TOKEN=

# Segredo que o Telegram envia em cada chamada ao site, para provar que e ele.
# Qualquer texto longo e aleatorio.
TELEGRAM_WEBHOOK_SECRET=

# Senha para abrir /api/setup?key=... (registra o bot no site e mostra o status).
SETUP_KEY=

# Opcional: id do grupo/canal do DisparaPromo. Sem ele, o site salva mensagens
# de todos os chats onde o bot estiver. O /api/setup mostra os ids vistos.
TELEGRAM_CHAT_ID=

# Banco (criadas automaticamente quando voce conecta um Upstash Redis ao
# projeto em Storage na Vercel). Os nomes UPSTASH_REDIS_REST_* tambem servem.
KV_REST_API_URL=
KV_REST_API_TOKEN=
